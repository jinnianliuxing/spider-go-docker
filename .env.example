# Copy to .env for local deployment and replace every placeholder.
MYSQL_ROOT_PASSWORD=replace_with_a_new_mysql_password
MYSQL_DATABASE=spider_go
REDIS_PASSWORD=replace_with_a_new_redis_password
JWT_SECRET=replace_with_a_long_random_secret
SMTP_USERNAME=replace_with_your_smtp_account
SMTP_PASSWORD=replace_with_a_new_smtp_authorization_code
